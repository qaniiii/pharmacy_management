# Shared configuration for the monorepo. Copy to .env.local and fill in.
# Both /frontend and /backend read the repository-root .env.local.
# .env.local is git-ignored: never commit real keys.

# --- Supabase project -------------------------------------------------------
# Project settings -> API. The anon key is public by design; Row Level Security
# is what keeps tenants apart.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Used exclusively by the FastAPI provisioning endpoints. Never
# send this to the browser, never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Service URLs ------------------------------------------------------------
# Where the Next.js admin portal reaches FastAPI (server actions only) and the
# base URL Supabase invitation emails link back to.
API_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:3000

# --- Backend auth (optional) ------------------------------------------------
# Modern Supabase projects sign access tokens with ES256 and publish a JWKS
# endpoint; the API discovers it automatically. Leave this empty unless the
# project still signs with the legacy HS256 shared secret.
SUPABASE_JWT_SECRET=

# --- Backend HTTP (optional) ------------------------------------------------
# Accepted forms (both normalise to the same list):
#   CORS_ORIGINS=["https://your-app.vercel.app","https://staging.your-app.vercel.app"]
#   CORS_ORIGINS=https://your-app.vercel.app,https://staging.your-app.vercel.app
# BACKEND_CORS_ORIGINS and CORS_ALLOW_ORIGINS remain accepted aliases.
CORS_ORIGINS=http://localhost:3000

# --- Backend aliases (optional) ---------------------------------------------
# The API also accepts these non-public names if you prefer not to reuse the
# NEXT_PUBLIC_* variables:
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
